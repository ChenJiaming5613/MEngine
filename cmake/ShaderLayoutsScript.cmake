# cmake -P script run by MEngineGenerateShaderLayoutChecks. Inputs: JSON_FILES and STRUCTS ("|" separated), NAMESPACE,
# OUTPUT. Each struct's layout comes from the first constant buffer or push constant of that element type found.

cmake_minimum_required(VERSION 3.22)

string(REPLACE "|" ";" JSON_FILES "${JSON_FILES}")
string(REPLACE "|" ";" STRUCTS "${STRUCTS}")

set(BODY "")
foreach(STRUCT IN LISTS STRUCTS)
    set(FOUND FALSE)
    foreach(JSON_FILE IN LISTS JSON_FILES)
        if(FOUND)
            break()
        endif()
        file(READ "${JSON_FILE}" JSON)
        string(JSON PARAMETER_COUNT ERROR_VARIABLE JSON_ERROR LENGTH "${JSON}" parameters)
        if(JSON_ERROR)
            message(FATAL_ERROR "${JSON_FILE}: no parameters array (${JSON_ERROR})")
        endif()
        if(PARAMETER_COUNT EQUAL 0)
            continue()
        endif()
        math(EXPR LAST_PARAMETER "${PARAMETER_COUNT} - 1")
        foreach(PARAMETER RANGE ${LAST_PARAMETER})
            string(JSON KIND ERROR_VARIABLE JSON_ERROR GET "${JSON}" parameters ${PARAMETER} type kind)
            if(JSON_ERROR OR NOT KIND STREQUAL "constantBuffer")
                continue()
            endif()
            string(JSON TYPE_NAME ERROR_VARIABLE JSON_ERROR GET "${JSON}" parameters ${PARAMETER} type elementVarLayout type name)
            if(JSON_ERROR OR NOT TYPE_NAME STREQUAL STRUCT)
                continue()
            endif()

            string(JSON PARAMETER_NAME GET "${JSON}" parameters ${PARAMETER} name)
            string(JSON STRUCT_SIZE GET "${JSON}" parameters ${PARAMETER} type elementVarLayout binding size)
            get_filename_component(JSON_NAME "${JSON_FILE}" NAME)
            set(TYPE "${NAMESPACE}::${STRUCT}")
            string(APPEND BODY "// ${STRUCT}: parameter \"${PARAMETER_NAME}\" of ${JSON_NAME}\n")
            string(APPEND BODY "static_assert(sizeof(${TYPE}) == ${STRUCT_SIZE}, \"sizeof(${STRUCT}) differs from Slang (${STRUCT_SIZE})\");\n")

            string(JSON FIELD_COUNT LENGTH "${JSON}" parameters ${PARAMETER} type elementVarLayout type fields)
            if(FIELD_COUNT GREATER 0)
                math(EXPR LAST_FIELD "${FIELD_COUNT} - 1")
                foreach(FIELD RANGE ${LAST_FIELD})
                    string(JSON FIELD_NAME GET "${JSON}" parameters ${PARAMETER} type elementVarLayout type fields ${FIELD} name)
                    string(JSON FIELD_KIND ERROR_VARIABLE JSON_ERROR
                        GET "${JSON}" parameters ${PARAMETER} type elementVarLayout type fields ${FIELD} binding kind)
                    if(JSON_ERROR OR NOT FIELD_KIND STREQUAL "uniform")
                        message(FATAL_ERROR "${JSON_FILE}: ${STRUCT}.${FIELD_NAME} has no uniform layout")
                    endif()
                    string(JSON FIELD_OFFSET GET "${JSON}" parameters ${PARAMETER} type elementVarLayout type fields ${FIELD} binding offset)
                    string(JSON FIELD_SIZE GET "${JSON}" parameters ${PARAMETER} type elementVarLayout type fields ${FIELD} binding size)
                    string(APPEND BODY "static_assert(offsetof(${TYPE}, ${FIELD_NAME}) == ${FIELD_OFFSET}, "
                        "\"offset of ${STRUCT}::${FIELD_NAME} differs from Slang (${FIELD_OFFSET})\");\n")
                    string(APPEND BODY "static_assert(sizeof(${TYPE}::${FIELD_NAME}) == ${FIELD_SIZE}, "
                        "\"size of ${STRUCT}::${FIELD_NAME} differs from Slang (${FIELD_SIZE})\");\n")
                endforeach()
            endif()
            string(APPEND BODY "\n")
            set(FOUND TRUE)
            break()
        endforeach()
    endforeach()
    if(NOT FOUND)
        message(FATAL_ERROR "Shader layout checks: no constant buffer of type ${STRUCT} in ${JSON_FILES}")
    endif()
endforeach()

file(WRITE "${OUTPUT}" "// Generated by cmake/ShaderLayoutsScript.cmake from slangc -reflection-json. Do not edit.\n#pragma once\n\n#include <cstddef>\n\n${BODY}")
